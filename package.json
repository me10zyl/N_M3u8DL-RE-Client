{
  "name": "n-m3u8dl-re-client",
  "version": "1.0.2",
  "private": true,
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron . --disable-http-cache",
    "dist:win": "electron-builder -w",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "iconv-lite": "^0.6.3",
    "safer-buffer": "^2.1.2"
  },
  "build": {
    "asar": true,
    "extraResources": [
      {
        "from": "bin/ffmpeg.exe",
        "to": "bin/ffmpeg.exe"
      },
      {
        "from": "bin/N_m3u8DL-RE.exe",
        "to": "bin/N_m3u8DL-RE.exe"
      }
    ]
  }
}
